<Window x:Class="Library.Views.Loans.AddLoanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выдать книгу" Height="260" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#F5F0EB">

    <Border Margin="20" Background="White" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Книга:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#2C3E50"/>
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="BookCombo" DisplayMemberPath="Title" Margin="5" Background="#F9F6F2" BorderBrush="#B0A89A"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Читатель:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#2C3E50"/>
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ReaderCombo" DisplayMemberPath="FullName" Margin="5" Background="#F9F6F2" BorderBrush="#B0A89A"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Дата выдачи:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#2C3E50"/>
            <DatePicker Grid.Row="2" Grid.Column="1" x:Name="LoanDatePicker" Margin="5" Background="#F9F6F2" BorderBrush="#B0A89A"/>

            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Выдать" Width="100" Margin="5" Click="Save_Click" Background="#3E5A6D" Foreground="White" BorderThickness="0" Padding="10,6" FontWeight="SemiBold" Cursor="Hand"/>
                <Button Content="Отмена" Width="100" Margin="5" Click="Cancel_Click" Background="#E74C3C" Foreground="White" BorderThickness="0" Padding="10,6" FontWeight="SemiBold" Cursor="Hand"/>
            </StackPanel>

            <TextBlock Grid.Row="4" Grid.ColumnSpan="2" x:Name="ErrorText" Foreground="#E74C3C" TextWrapping="Wrap" Margin="5"/>
        </Grid>
    </Border>
</Window>